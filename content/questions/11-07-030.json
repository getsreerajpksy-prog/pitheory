  "diagram_alt": "",
  "options": [
    {
      "text": "$2v_e$",
      "image": ""
    },
    {
      "text": "$\\dfrac{v_e}{\\sqrt{2}}$",
      "image": ""
    },
    {
      "text": "$\\sqrt{2}\\,v_e$",
      "image": ""
    },
    {
      "text": "$\\dfrac{v_e}{2}$",
      "image": ""
    }
  ],
  "answer": "B",
  "numerical_answer": "",
  "tolerance": "",
  "solution": "$v_e = \\sqrt{\\dfrac{2GM}{R}}$, so with the same mass $v_e \\propto \\dfrac{1}{\\sqrt{R}}$:\n$$v' = \\frac{v_e}{\\sqrt{2}}$$",
