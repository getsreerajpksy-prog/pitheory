      "text": "$6.28$ s",
      "image": ""
    },
    {
      "text": "$3.14$ s",
      "image": ""
    }
  ],
  "answer": "A",
  "numerical_answer": "",
  "tolerance": "",
  "solution": "$$k = \\frac{F}{x} = \\frac{10}{0.05} = 200\\ \\text{N/m}$$\n\n$$T = 2\\pi\\sqrt{\\frac{m}{k}} = 2\\pi\\sqrt{\\frac{2}{200}} = \\frac{2\\pi}{10} = 0.628\\ \\text{s}$$",
