    {
      "text": "$\\dfrac{1}{\\sqrt{2}\\,n\\pi d^2}$",
      "image": ""
    },
    {
      "text": "$\\dfrac{1}{\\sqrt{2}\\,n^2\\pi d^2}$",
      "image": ""
    },
    {
      "text": "$\\dfrac{1}{\\sqrt{2}\\,n^2\\pi^2d^2}$",
      "image": ""
