  ],
  "answer": "C",
  "numerical_answer": "",
  "tolerance": "",
  "solution": "$\\text{LC} = \\dfrac{\\text{pitch}}{\\text{number of circular divisions}}$, so\n$$\\text{pitch} = 0.01 \\times 50 = 0.5\\ \\text{mm}$$",
